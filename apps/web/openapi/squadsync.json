  "components": {
    "schemas": {
      "AddPlayerRequest": {
        "required": ["rosterStatus"],
        "type": "object",
        "properties": {
          "personId": { "type": "string", "format": "uuid", "nullable": true },
          "newPerson": { "$ref": "#/components/schemas/CreatePersonRequest" },
          "jerseyNumber": {
            "type": "string",
            "description": "Nullable, otherwise 1-3 ASCII digits. Leading zeros are preserved.",
            "nullable": true
          },
          "rosterStatus": {
            "minLength": 1,
            "pattern": "^(Active|Reserved|Suspended)$",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Supply exactly one non-null personId or newPerson. Reuses an unrostered Player membership; staff and duplicate roster entries conflict. No PlayerProfile is created."
      },
      "CreateMembershipRequest": {
        "required": ["personId", "teamRole"],
        "type": "object",
        "properties": {
          "personId": { "type": "string", "format": "uuid" },
          "teamRole": {
            "minLength": 1,
            "pattern": "^(Owner|Coach|AssistantCoach|Manager|Player|Viewer)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreatePersonRequest": {
        "required": ["firstName", "lastName"],
        "type": "object",
        "properties": {
          "firstName": { "minLength": 1, "type": "string" },
          "lastName": { "minLength": 1, "type": "string" }
        },
        "additionalProperties": false
      },
      "CreatePlayerProfileRequest": {
        "type": "object",
        "properties": {
          "dominantFoot": {
            "pattern": "^(Left|Right|Both)$",
            "type": "string",
            "nullable": true
          },
          "heightInches": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "weightPounds": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateRosterEntryRequest": {
        "required": ["rosterStatus", "teamMembershipId"],
        "type": "object",
        "properties": {
          "teamMembershipId": { "type": "string", "format": "uuid" },
          "jerseyNumber": { "type": "string", "nullable": true },
          "rosterStatus": {
            "minLength": 1,
            "pattern": "^(Active|Reserved|Suspended)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateTeamRequest": {
        "required": ["name"],
        "type": "object",
        "properties": { "name": { "minLength": 1, "type": "string" } },
        "additionalProperties": false
      },
      "MembershipPersonResponse": {
        "required": ["firstName", "id", "lastName"],
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "firstName": { "minLength": 1, "type": "string" },
          "lastName": { "minLength": 1, "type": "string" }
        },
        "additionalProperties": false
      },
      "MembershipResponse": {
        "required": ["id", "person", "teamId", "teamRole"],
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "teamId": { "type": "string", "format": "uuid" },
          "person": { "$ref": "#/components/schemas/MembershipPersonResponse" },
          "teamRole": { "minLength": 1, "type": "string" }
        },
        "additionalProperties": false
      },
      "PersonCandidatePageResponse": {
        "required": ["items", "nextCursor"],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PersonCandidateResponse" }
          },
          "nextCursor": { "type": "string", "nullable": true }
        },
        "additionalProperties": false
      },
      "PersonCandidateResponse": {
        "required": ["firstName", "lastName", "personId"],
        "type": "object",
        "properties": {
          "personId": { "type": "string", "format": "uuid" },
          "firstName": { "minLength": 1, "type": "string" },
          "lastName": { "minLength": 1, "type": "string" }
        },
        "additionalProperties": false
      },
      "PersonResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "firstName": { "type": "string", "nullable": true },
          "lastName": { "type": "string", "nullable": true }
        },
        "additionalProperties": false
      },
      "PlayerProfileResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "personId": { "type": "string", "format": "uuid" },
          "dominantFoot": { "type": "string", "nullable": true },
          "heightInches": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "weightPounds": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "nullable": true },
          "title": { "type": "string", "nullable": true },
          "status": { "type": "integer", "format": "int32", "nullable": true },
          "detail": { "type": "string", "nullable": true },
          "instance": { "type": "string", "nullable": true }
        },
        "additionalProperties": {}
      },
      "RosterEntryResponse": {
        "required": ["id", "jerseyNumber", "person", "rosterStatus", "teamMembershipId"],
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "teamMembershipId": { "type": "string", "format": "uuid" },
          "person": { "$ref": "#/components/schemas/RosterPersonResponse" },
          "jerseyNumber": { "type": "string", "nullable": true },
          "rosterStatus": { "minLength": 1, "type": "string" }
        },
        "additionalProperties": false
      },
      "RosterPersonResponse": {
        "required": ["firstName", "id", "lastName"],
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "firstName": { "minLength": 1, "type": "string" },
          "lastName": { "minLength": 1, "type": "string" }
        },
        "additionalProperties": false
      },
      "TeamResponse": {
        "required": ["id", "name"],
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "minLength": 1, "type": "string" }
        },
        "additionalProperties": false
      },
      "UpdatePlayerProfileRequest": {
        "required": ["dominantFoot", "heightInches", "weightPounds"],
        "type": "object",
        "properties": {
          "dominantFoot": {
            "pattern": "^(Left|Right|Both)$",
            "type": "string",
            "nullable": true
          },
          "heightInches": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "weightPounds": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "nullable": true },
          "title": { "type": "string", "nullable": true },
          "status": { "type": "integer", "format": "int32", "nullable": true },
          "detail": { "type": "string", "nullable": true },
          "instance": { "type": "string", "nullable": true },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            },
            "nullable": true
          }
        },
        "additionalProperties": {}
      }
    }
  },
